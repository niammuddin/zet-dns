SOURCE_NAME=domains_isp
SOURCE_URL=https://trustpositif.komdigi.go.id/assets/db/domains_isp
DBDIR=/var/lib/dnstrust

MIN_BYTES=50000000
MIN_DOMAINS=1000000
MIN_FREE_BYTES=2000000000
MAX_REJECTED_LINES=10000
MAX_SHRINK_PERCENT=20
RELATIVE_CHECK_MIN_DOMAINS=100000

HEALTHCHECK_SERVER=127.0.0.1
HEALTHCHECK_PORT=53
HEALTHCHECK_ALLOWED_DOMAIN=google.com
DNSTRUST_CONTROL_COMMAND=/usr/local/sbin/dnstrust-control
